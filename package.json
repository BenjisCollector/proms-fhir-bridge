{
  "name": "proms-fhir-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Integration service: NHS PDS sandbox lookup and PROM results pushed to a FHIR R4 server. Portfolio project.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
